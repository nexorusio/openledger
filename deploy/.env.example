DOMAIN=openledger.nexorus.io
FLASK_SECRET_KEY=REPLACE_WITH_OPENSSL_RANDOM_VALUE
SEARXNG_SECRET=REPLACE_WITH_A_DIFFERENT_OPENSSL_RANDOM_VALUE
OPENAI_MODEL=gpt-5.6-terra
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENLEDGER_ALLOW_CUSTOM_AI_ENDPOINT=false
OPENLEDGER_ALLOW_PRIVATE_AI_ENDPOINT=false
OPENLEDGER_PROFILE_DISCOVERY_ENABLED=true
OPENLEDGER_FOCUSED_DISCOVERY_ENABLED=true
OPENLEDGER_EXHAUSTIVE_DISCOVERY_ENABLED=true
OPENLEDGER_MAIGRET_DISCOVERY_ENABLED=true
OPENLEDGER_USER_SCANNER_DISCOVERY_ENABLED=true
OPENLEDGER_ENRICHMENT_PROVIDERS_ENABLED=true
OPENLEDGER_PROVIDER_CIRCUIT_BREAKERS_ENABLED=true
OPENLEDGER_GOVERNED_PIVOTS_ENABLED=false
OPENLEDGER_UNIFIED_INVESTIGATION_INPUT_ENABLED=false
OPENLEDGER_SEARCH_FIRST_DISCOVERY_ENABLED=false
OPENLEDGER_PROFILE_SEARCH_PROVIDER=disabled
OPENLEDGER_PROFILE_SEARCH_TIMEOUT_SECONDS=10
OPENLEDGER_PROFILE_SEARCH_MAX_RESULTS=5
