{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openledger.invalid/schemas/evidence-correlation-result.v2.schema.json",
  "title": "OpenLedger compact evidence correlation result v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "clusters",
    "relationships",
    "relationship_projection",
    "compact_relationships"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "case_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "clusters": {"type": "array", "items": {"type": "object"}},
    "relationships": {"type": "array", "items": {"type": "object"}},
    "relationship_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "automatic_relationship_counts",
        "materialized_automatic_relationship_count"
      ],
      "properties": {
        "mode": {"const": "compact"},
        "automatic_relationship_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["duplicate", "supporting", "total"],
          "properties": {
            "duplicate": {"type": "integer", "minimum": 0},
            "supporting": {"type": "integer", "minimum": 0},
            "total": {"type": "integer", "minimum": 0}
          }
        },
        "materialized_automatic_relationship_count": {"const": 0}
      }
    },
    "compact_relationships": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "representation",
        "explicit_pair_overrides",
        "duplicate_memberships",
        "supporting_memberships",
        "excluded_pairs"
      ],
      "properties": {
        "representation": {"const": "membership-v1"},
        "explicit_pair_overrides": {"const": true},
        "duplicate_memberships": {"type": "array", "items": {"$ref": "#/$defs/duplicateMembership"}},
        "supporting_memberships": {"type": "array", "items": {"$ref": "#/$defs/supportingMembership"}},
        "excluded_pairs": {"type": "array", "items": {"$ref": "#/$defs/excludedPair"}}
      }
    }
  },
  "$defs": {
    "observationId": {
      "type": "string",
      "pattern": "^evidence-observation:[0-9a-f]{64}$"
    },
    "clusterId": {
      "type": "string",
      "pattern": "^evidence-cluster:[0-9a-f]{64}$"
    },
    "relationshipId": {
      "type": "string",
      "pattern": "^evidence-relationship:[0-9a-f]{64}$"
    },
    "duplicateMembership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cluster_id", "source_snapshot_sha256", "observation_ids"],
      "properties": {
        "cluster_id": {"$ref": "#/$defs/clusterId"},
        "source_snapshot_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "observation_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/observationId"}}
      }
    },
    "supportingMembership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cluster_id", "observation_ids"],
      "properties": {
        "cluster_id": {"$ref": "#/$defs/clusterId"},
        "observation_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/observationId"}}
      }
    },
    "excludedPair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left_observation_id", "right_observation_id", "relationship_ids"],
      "properties": {
        "left_observation_id": {"$ref": "#/$defs/observationId"},
        "right_observation_id": {"$ref": "#/$defs/observationId"},
        "relationship_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/relationshipId"}}
      }
    }
  }
}
