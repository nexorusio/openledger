{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openledger.invalid/schemas/evidence-correlation-envelope.v1.schema.json",
  "title": "OpenLedger evidence correlation envelope v1",
  "oneOf": [
    {"$ref": "#/$defs/observation"},
    {"$ref": "#/$defs/relationship"}
  ],
  "$defs": {
    "caseId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "observationId": {
      "type": "string",
      "pattern": "^evidence-observation:[0-9a-f]{64}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "title"],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 2000
        },
        "title": {"type": "string", "maxLength": 300}
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "score", "basis"],
      "properties": {
        "scope": {"enum": ["correlation", "review_priority"]},
        "score": {"type": "integer", "minimum": 0, "maximum": 100},
        "basis": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 500}
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "observation_id",
        "cluster_id",
        "case_id",
        "claim_type",
        "claim_value",
        "canonical_profile_identity",
        "source_id",
        "source_version",
        "source_record_id",
        "outcome",
        "native_outcome",
        "native_status",
        "citations",
        "retrieved_at",
        "originating_query",
        "originating_query_fingerprint",
        "source_snapshot_sha256",
        "source_snapshot_ref"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "observation_id": {"$ref": "#/$defs/observationId"},
        "cluster_id": {
          "type": "string",
          "pattern": "^evidence-cluster:[0-9a-f]{64}$"
        },
        "case_id": {"$ref": "#/$defs/caseId"},
        "claim_type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._:-]{0,99}$"
        },
        "claim_value": {"type": "string", "minLength": 1, "maxLength": 2000},
        "canonical_profile_identity": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["platform", "handle", "canonical_url"],
              "properties": {
                "platform": {"enum": ["facebook", "instagram", "threads", "tiktok", "x"]},
                "handle": {"type": "string", "minLength": 1, "maxLength": 128},
                "canonical_url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://",
                  "maxLength": 2000
                }
              }
            }
          ]
        },
        "source_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,99}$"
        },
        "source_version": {"type": "string", "minLength": 1, "maxLength": 200},
        "source_record_id": {"type": "string", "minLength": 1, "maxLength": 500},
        "outcome": {
          "enum": [
            "observed",
            "absent",
            "private",
            "blocked",
            "rate_limited",
            "parser_error",
            "provider_error",
            "indeterminate"
          ]
        },
        "native_outcome": {"type": "string", "minLength": 1, "maxLength": 200},
        "native_status": {"type": "string", "minLength": 1, "maxLength": 200},
        "citations": {
          "type": "array",
          "maxItems": 32,
          "items": {"$ref": "#/$defs/citation"}
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$",
          "maxLength": 64
        },
        "originating_query": {"type": "string", "minLength": 1, "maxLength": 1000},
        "originating_query_fingerprint": {"$ref": "#/$defs/sha256"},
        "source_snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "source_snapshot_ref": {
          "type": "string",
          "pattern": "^(evidence://|urn:|https://)",
          "minLength": 1,
          "maxLength": 2000
        },
        "confidence": {"$ref": "#/$defs/confidence"}
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "relationship_id",
        "case_id",
        "left_observation_id",
        "left_case_id",
        "right_observation_id",
        "right_case_id",
        "relationship_kind",
        "basis"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "relationship_id": {
          "type": "string",
          "pattern": "^evidence-relationship:[0-9a-f]{64}$"
        },
        "case_id": {"$ref": "#/$defs/caseId"},
        "left_observation_id": {"$ref": "#/$defs/observationId"},
        "left_case_id": {"$ref": "#/$defs/caseId"},
        "right_observation_id": {"$ref": "#/$defs/observationId"},
        "right_case_id": {"$ref": "#/$defs/caseId"},
        "relationship_kind": {
          "enum": ["supporting", "duplicate", "conflicting", "unrelated"]
        },
        "basis": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    }
  }
}
