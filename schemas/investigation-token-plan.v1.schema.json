{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openledger.invalid/schemas/investigation-token-plan.v1.schema.json",
  "title": "OpenLedger unified investigation token plan v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "input_contract",
    "token_schema_version",
    "processing_mode",
    "requested_mode",
    "execution_mode",
    "tokens",
    "identifiers",
    "search_targets",
    "route_plan"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "input_contract": {"const": "investigation-tokens-v1"},
    "token_schema_version": {"const": 1},
    "processing_mode": {"const": "same_subject"},
    "requested_mode": {"enum": ["quick", "full"]},
    "execution_mode": {"enum": ["focused", "exhaustive"]},
    "tokens": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {"$ref": "#/$defs/token"}
    },
    "identifiers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "search_targets": {
      "type": "array",
      "maxItems": 24,
      "items": {"$ref": "#/$defs/searchTarget"}
    },
    "route_plan": {"$ref": "#/$defs/routePlan"}
  },
  "$defs": {
    "tokenType": {
      "enum": [
        "email",
        "full_name",
        "phone",
        "profile_url",
        "public_url",
        "social_handle",
        "username"
      ]
    },
    "token": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "type",
        "value",
        "duplicate_key",
        "context_only"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "type": {"$ref": "#/$defs/tokenType"},
        "value": {"type": "string", "minLength": 1, "maxLength": 2000},
        "input": {"type": "string", "minLength": 1, "maxLength": 2000},
        "predicted_type": {"$ref": "#/$defs/tokenType"},
        "type_source": {"enum": ["automatic", "analyst_override"]},
        "ambiguous_types": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/tokenType"}
        },
        "duplicate_key": {
          "type": "string",
          "pattern": "^[a-z_]+:[0-9a-f]{64}$"
        },
        "context_only": {"type": "boolean"},
        "account_targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        }
      }
    },
    "identifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": {"$ref": "#/$defs/tokenType"},
        "value": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "searchTarget": {
      "type": "object",
      "additionalProperties": true,
      "required": ["value", "source_type", "source_value"],
      "properties": {
        "value": {"type": "string", "minLength": 1, "maxLength": 128},
        "source_type": {
          "enum": ["profile_url", "ranked_alias", "social_handle", "username"]
        },
        "source_value": {"type": "string", "minLength": 1, "maxLength": 2000},
        "alias_score": {"type": "integer", "minimum": 0, "maximum": 100},
        "alias_reason": {"type": "string", "maxLength": 240}
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": true,
      "required": ["route", "label", "kind", "target_count", "token_types"],
      "properties": {
        "route": {
          "enum": [
            "context_only",
            "likely_username_aliases",
            "maigret",
            "native_profile_search",
            "user_scanner_email"
          ]
        },
        "label": {"type": "string", "minLength": 1, "maxLength": 120},
        "kind": {"enum": ["collection", "context", "planning"]},
        "target_count": {"type": "integer", "minimum": 0, "maximum": 24},
        "token_types": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 40}
        },
        "requires_confirmation": {"type": "boolean"},
        "coverage": {
          "enum": [
            "all_eligible_enabled_non_quarantined",
            "configured_top_ranked_enabled_non_quarantined"
          ]
        },
        "planned_request_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 25
        },
        "reason_code": {
          "enum": [
            "confirmation_required",
            "context_only_no_outbound",
            "server_disabled"
          ]
        }
      }
    },
    "routePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "policy_version",
        "server_authoritative",
        "input_sha256",
        "requested_mode",
        "execution_mode",
        "budget_seconds",
        "requested_routes",
        "effective_routes",
        "skipped_routes",
        "sha256"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "policy_version": {"const": "investigation-routes-v1"},
        "server_authoritative": {"const": true},
        "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "requested_mode": {"enum": ["quick", "full"]},
        "execution_mode": {"enum": ["focused", "exhaustive"]},
        "budget_seconds": {"enum": [600, 1800]},
        "requested_routes": {
          "type": "array",
          "maxItems": 8,
          "items": {"$ref": "#/$defs/route"}
        },
        "effective_routes": {
          "type": "array",
          "maxItems": 8,
          "items": {"$ref": "#/$defs/route"}
        },
        "skipped_routes": {
          "type": "array",
          "maxItems": 8,
          "items": {"$ref": "#/$defs/route"}
        },
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
