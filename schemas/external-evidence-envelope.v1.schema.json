{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openledger.invalid/schemas/external-evidence-envelope.v1.schema.json",
  "title": "OpenLedger external evidence envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_id",
    "source_record_id",
    "source_version",
    "record_type",
    "content_hash",
    "observed_at",
    "handling",
    "locator"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "source_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,99}$"},
    "source_record_id": {"type": "string", "minLength": 1, "maxLength": 500},
    "source_version": {"type": "string", "minLength": 1, "maxLength": 200},
    "record_type": {"type": "string", "pattern": "^[a-z][a-z0-9._:-]{0,99}$"},
    "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "observed_at": {"type": "string", "format": "date-time"},
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": {"type": ["string", "null"], "format": "date-time"},
        "to": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "handling": {
      "type": "object",
      "required": ["classification", "authority"],
      "properties": {
        "classification": {"type": "string", "minLength": 1, "maxLength": 64},
        "authority": {"type": "string", "minLength": 1, "maxLength": 200},
        "policy_tags": {
          "type": "array",
          "maxItems": 32,
          "items": {"type": "string", "minLength": 1, "maxLength": 64}
        }
      }
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri"],
      "properties": {"uri": {"type": "string", "minLength": 1, "maxLength": 2000}}
    },
    "attributes": {"type": "object"},
    "preview": {"type": "string", "maxLength": 12000}
  }
}
